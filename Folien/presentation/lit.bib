@article{croitoru_phonon_2015,
	title = {Phonon limited superconducting correlations in metallic nanograins},
	volume = {5},
	issn = {2045-2322},
	url = {https://www.nature.com/articles/srep16515},
	doi = {10.1038/srep16515},
	abstract = {Abstract
            
              Conventional superconductivity is inevitably suppressed in ultra-small metallic grains for characteristic sizes smaller than the Anderson limit. Experiments have shown that above the Anderson limit the critical temperature may be either enhanced or reduced when decreasing the particle size, depending on the superconducting material. In addition, there is experimental evidence that whether an enhancement or a reduction is found depends on the strength of the electron-phonon interaction in the bulk. We reveal how the strength of the
              e-ph
              interaction interplays with the quantum-size effect and theoretically obtain the critical temperature of the superconducting nanograins in excellent agreement with experimental data. We demonstrate that strong
              e-ph
              scattering smears the peak structure in the electronic density-of-states of a metallic grain and enhances the electron mass and thereby limits the highest
              T
              
                c
              
              achievable by quantum confinement.},
	language = {en},
	number = {1},
	urldate = {2026-08-10},
	journal = {Sci Rep},
	author = {Croitoru, M. D. and Shanenko, A. A. and Vagov, A. and Milošević, M. V. and Axt, V. M. and Peeters, F. M.},
	month = nov,
	year = {2015},
	pages = {16515},
	file = {PDF:/home/jrose/Zotero/storage/3NR2EXKF/Croitoru et al. - 2015 - Phonon limited superconducting correlations in metallic nanograins.pdf:application/pdf},
}

