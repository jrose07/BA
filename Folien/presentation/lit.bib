@article{althuser_collective_2025,
	title = {Collective modes in superconductors including {Coulomb} repulsion},
	volume = {19},
	issn = {2542-4653},
	url = {https://scipost.org/10.21468/SciPostPhys.19.3.067},
	doi = {10.21468/SciPostPhys.19.3.067},
	abstract = {We numerically study the collective excitations present in isotropic superconductors including a screened Coulomb interaction. By varying the screening strength, we analyze its impact on the system. We use a formulation of the effective phonon-mediated interaction between electrons that depends on the energy transfer between particles, rather than being a constant in a small energy shell around the Fermi edge. This justifies considering also rather large attractive interactions. We compute the system’s Green’s functions using the iterated equations of motion (iEoM) approach, which ultimately enables a quantitative analysis of collective excitations. For weak couplings, we identify the well-known amplitude (Higgs) mode at the two-particle continuum’s lower edge and the phase (Anderson-Bogoliubov) mode at ω = 0 for a neutral system, which shifts to higher energies as the Coulomb interaction is switched on. As the phononic coupling is increased, the Higgs mode separates from the continuum, and additional phase and amplitude modes appear, persisting even in the presence Coulomb interactions.},
	language = {en},
	number = {3},
	urldate = {2026-08-07},
	journal = {SciPost Phys.},
	author = {Althüser, Joshua and Uhrig, Götz S.},
	month = sep,
	year = {2025},
	pages = {067},
	file = {PDF:/home/jrose/Zotero/storage/2TYAUGBL/Althüser und Uhrig - 2025 - Collective modes in superconductors including Coulomb repulsion.pdf:application/pdf},
}

