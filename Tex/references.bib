	year = {2014},
	pages = {676},
	file = {PDF:/home/jrose/Zotero/storage/K8I5QWU8/Lu und Leburton - 2014 - Electronic structures of defects and magnetic impurities in MoS2 monolayers.pdf:application/pdf},
}

@article{peng_thermal_2016,
	title = {Thermal conductivity of monolayer {MoS}$_{\textrm{2}}$ , {MoSe}$_{\textrm{2}}$ , and {WS}$_{\textrm{2}}$ : interplay of mass effect, interatomic bonding and anharmonicity},
	volume = {6},
