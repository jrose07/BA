	note = {arXiv:1301.1267 [cond-mat.str-el]},
	keywords = {Condensed Matter - Strongly Correlated Electrons, Condensed Matter - Superconductivity, Condensed Matter - Quantum Gases},
	pages = {094521},
	file = {PDF:/home/jrose/Zotero/storage/H9PBSQGX/Wu et al. - 2013 - Correlated Dirac Particles and Superconductivity on the Honeycomb Lattice.pdf:application/pdf},
